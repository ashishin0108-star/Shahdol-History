<!-- Main Narrative Body -->
<div class="max-w-[1360px] mx-auto w-full px-margin py-space-xl flex flex-col gap-space-xl">
<!-- Section 1: Origin & Etymology (नामकरण का इतिहास) -->
<section class="w-full scroll-mt-24" id="etymology">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-center">
<div class="lg:col-span-5 order-2 lg:order-1">
<div class="relative rounded-xl overflow-hidden shadow-md bg-surface-container">
<img class="w-full h-[420px] object-cover" data-alt="A historic documentary style atmospheric painting of 18th century rural Central India featuring a dense sal forest meadow with grazing cattle herd, an aged revered Ahir shepherd elder resting under an ancient banyan tree with wooden staff, rustic clay huts of ancient Sohagpur village in background bathed in golden evening sunlight." src="https://lh3.googleusercontent.com/aida-public/AB6AXuAgqsqcpaLOpikeYit6XCKf6b_H_26aC59iPLl6bFDtANWnj8_WxZSuBP1dOUMpP6Uy4nOmTTp4_HQfZv_ELEEqimi7DZBJAi4vEAVKPOQqIhDZkkmcOg1uYfpyOYdgmpymudX9nRAkl8_bvvNLDg3rKl1t7vIWIJsCUy_xudbtS6I9pcWZ43kGZrxqpBncAv6kXxNV5NWq9iBg5leQZhod8GmglGQSvuw8tFat5pM"/>
<div class="p-space-md bg-surface-container-lowest">
<span class="font-label-sm text-label-sm text-secondary uppercase font-bold tracking-wider">ऐतिहासिक जनश्रुति एवं अभिलेख</span>
<p class="font-body-sm text-body-sm text-on-surface-variant mt-1">
                सोहागपुर छावनी के समीप तत्कालीन चारागाह और शाहडोलवा अहीर के पुरवे से विकसित हुआ आधुनिक शहर।
              </p>
</div>
</div>
</div>
<div class="lg:col-span-7 order-1 lg:order-2 flex flex-col gap-space-sm">
<div class="flex items-center gap-space-xs text-secondary font-label-md text-label-md uppercase tracking-wider">
<span class="material-symbols-outlined text-[18px]">history_edu</span>
            भाग ०१ : उद्भव एवं नामकरण
          </div>
<h2 class="font-headline-lg text-headline-lg text-primary tracking-tight">
            ‘शाहडोलवा अहीर’ की स्मृति से आधुनिक मुख्यालय तक
          </h2>
<div class="h-1 w-20 bg-secondary rounded-full"></div>
<div class="flex flex-col gap-space-sm text-on-surface font-body-md text-body-md leading-relaxed mt-space-xs">
<p>
              शहडोल जिले का नामकरण इसके मुख्यालय शहर ‘शहडोल’ के नाम पर हुआ है। ऐतिहासिक एवं जनसांख्यिकी गजेटियर के अनुसार, सोहागपुर प्राचीन काल का मुख्य प्रशासनिक व सांस्कृतिक केंद्र हुआ करता था। सोहागपुर के पूर्वोत्तर में विस्तृत घने जंगलों और सोन नदी के जल-प्रवाह क्षेत्र में चरवाहों की एक छोटी बस्ती थी।
            </p>
<p>
              जनश्रुति व रीवा स्टेट गजेटियर के अनुसार, इस बसावट के मुख्य संस्थापक एक निष्ठावान व प्रतिष्ठित चरवाहे थे जिन्हें लोकभाषा में <strong>‘शाहडोलवा अहीर’</strong> (Shahdolwa Ahir) कहा जाता था। उनके नाम पर इस पुरवे का नाम पहले ‘शाहडोलवा’ और कालान्तर में अपभ्रंश होकर ‘शहडोल’ (Shahdol) प्रचलित हुआ।
            </p>
<p>
              मुगल काल और बघेल राजाओं के समय यह क्षेत्र मुख्य रूप से वनाच्छादित जनजातीय बहुल भूभाग था, जहां से गुजरने वाले व्यापारिक व सैन्य कारवां सोहागपुर की गढ़ी में विश्राम करते थे। 19वीं सदी के अंत में जब कटनी-बिलासपुर रेल लाइन (बंगाल नागपुर रेलवे) का विस्तार हुआ, तब शहडोल रेलवे स्टेशन का निर्माण हुआ और प्रशासनिक महत्ता सोहागपुर से स्थानांतरित होकर शहडोल में केंद्रित हो गई।
            </p>
</div>
<div class="mt-space-sm p-space-md rounded-xl bg-surface-container-high flex flex-col sm:flex-row items-start sm:items-center gap-space-md">
<span class="material-symbols-outlined text-secondary text-[36px] flex-shrink-0">format_quote</span>
<div class="text-on-surface">
<span class="font-title-md text-title-md font-bold block">गजेटियर टिप्पणी (1908 Imperial Gazetteer):</span>
<p class="font-body-sm text-body-sm text-on-surface-variant italic">
                “Sohagpur was historically the headquarters of the ilaka, but with the opening of the Bengal-Nagpur Railway, Shahdol situated two miles north grew rapidly into a bustling commercial mart.”
              </p>
</div>
</div>
</div>
</div>
</section>
<!-- Section 2: Dynasty & History: Kalachuri to Rewa State & Post-Independence -->
<section class="w-full bg-surface-container-lowest p-space-lg lg:p-space-xl rounded-xl shadow-sm">
<div class="flex flex-col gap-space-md">
<div class="flex flex-col gap-space-xs">
<span class="text-secondary font-label-md text-label-md uppercase tracking-wider font-bold flex items-center gap-1">
<span class="material-symbols-outlined text-[18px]">crown</span>
            भाग ०२ : राजवंश एवं प्रशासनिक इतिहास
          </span>
<h2 class="font-headline-lg text-headline-lg text-primary">
            कलचुरी साम्राज्य, बघेल रियासत और 1948-2003 पुनर्गठन
          </h2>
<div class="h-1 w-24 bg-primary rounded-full"></div>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-gutter mt-space-sm">
<!-- Col 1: Kalachuri Era -->
<div class="flex flex-col gap-space-sm p-space-md rounded-xl bg-surface-container-low hover:bg-surface-container transition-colors">
<div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center text-on-primary font-bold">
              १
            </div>
<h3 class="font-headline-sm text-headline-sm text-primary">
              कलचुरी वंश (१०वीं-१२वीं सदी)
            </h3>
<span class="font-label-sm text-label-sm text-secondary font-semibold">त्रिपुरी के कलचुरी शासकों का स्वर्णिम युग</span>
<p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
              सोहागपुर और समीपवर्ती अंचल त्रिपुरी (वर्तमान जबलपुर) के कलचुरी राजाओं के अधीन अत्यंत समृद्ध था। राजा युवराजदेव प्रथम एवं कर्णदेव के शासनकाल में यहाँ शैव मत के भव्य देवालयों, बावलियों और मूर्तिकला का अद्भुत विकास हुआ। सोहागपुर का विराटेश्वर मंदिर इसी वैभवशाली वास्तुकला का अनुपम प्रमाण है।
            </p>
</div>
<!-- Col 2: Rewa Princely State -->
<div class="flex flex-col gap-space-sm p-space-md rounded-xl bg-surface-container-low hover:bg-surface-container transition-colors">
<div class="w-10 h-10 rounded-full bg-secondary flex items-center justify-center text-on-secondary font-bold">
              २
            </div>
<h3 class="font-headline-sm text-headline-sm text-secondary">
              बघेलखंड व रीवा रियासत
            </h3>
<span class="font-label-sm text-label-sm text-primary font-semibold">इलाका सोहागपुर व प्रशासनिक व्यवस्था</span>
<p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
              १४वीं-१५वीं सदी में बघेल राजाओं ने इस क्षेत्र को रीवा रियासत में समाहित किया। सोहागपुर को रियासत की दक्षिणी सैन्य चौकी और परगना मुख्यालय बनाया गया। यहाँ निर्मित सोहागपुर गढ़ी एवं पुरानी कचहरी बघेल राजवंश के कुशल प्रशासनिक ढांचे और सामरिक नियंत्रण की साक्षी रही हैं।
            </p>
</div>
<!-- Col 3: 1948 to 2003 Reorganization -->
<div class="flex flex-col gap-space-sm p-space-md rounded-xl bg-surface-container-low hover:bg-surface-container transition-colors">
<div class="w-10 h-10 rounded-full bg-tertiary flex items-center justify-center text-on-tertiary font-bold">
              ३
            </div>
<h3 class="font-headline-sm text-headline-sm text-tertiary">
              विलय एवं आधुनिक पुनर्गठन
            </h3>
<span class="font-label-sm text-label-sm text-secondary font-semibold">१९४८ विंध्य प्रदेश से २००३ का त्रिविभाजन</span>
<p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
              १९४८ में रीवा सहित विंध्य रियासतों का विलय हुआ। प्रारंभ में जिला मुख्यालय उमरिया था, जिसे प्रशासनिक सुगमता हेतु शहडोल स्थानांतरित किया गया। १ नवंबर १९५६ को यह नवगठित मध्य प्रदेश का अंग बना। कालांतर में १५ अगस्त २००३ को अनूपपुर और उमरिया के पृथक जिले बनने के पश्चात वर्तमान शहडोल अस्तित्व में आया।
            </p>
</div>
</div>
<!-- Geographic & Demarcation Fact Box -->
<div class="mt-space-md p-space-md rounded-xl bg-surface-container-highest text-on-surface">
<div class="grid grid-cols-1 md:grid-cols-12 gap-space-md items-center">
<div class="md:col-span-8">
<span class="font-title-md text-title-md font-bold text-primary flex items-center gap-2">
<span class="material-symbols-outlined text-secondary">verified</span>
                भौगोलिक क्षेत्रफल एवं प्रशासनिक सीमांकन (सत्यापन टिप्पणी)
              </span>
<p class="font-body-sm text-body-sm text-on-surface-variant mt-1 leading-relaxed">
                वर्ष २००३ के त्रिविभाजन (शहडोल, उमरिया, अनूपपुर) उपरांत आधिकारिक सांख्यिकी अनुसार वर्तमान शहडोल जिले का भौगोलिक क्षेत्रफल <strong>५,६०८ से ६,२०५ वर्ग किमी</strong> (वनक्षेत्र व राजस्व सीमांकन के विभिन्न सर्वेक्षणों के अनुसार) दर्ज है। जिला उत्तर में सतना व सीधी, दक्षिण में अनूपपुर, पूर्व में कोरिया (छत्तीसगढ़) तथा पश्चिम में उमरिया जिले से घिरा हुआ है।
              </p>
</div>
