<!-- Leadership Spotlight & Administrative Directory -->
<section class="w-full px-margin py-space-xl bg-surface">
<div class="flex flex-col gap-space-lg">
<div class="flex flex-col md:flex-row md:items-end justify-between gap-space-sm">
<div>
<span class="font-label-sm text-label-sm text-secondary uppercase tracking-widest font-bold">कार्यकारी नेतृत्व • प्रशासनिक संरचना</span>
<h2 class="font-headline-lg text-headline-lg text-primary">जिला प्रशासन एवं कलेक्ट्रेट नेतृत्व</h2>
</div>
<span class="font-body-sm text-body-sm text-on-surface-variant">अपडेट दिनांक: 01 अक्टूबर 2024 • सामान्य प्रशासन विभाग</span>
</div>
<div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-stretch">
<!-- District Collector Detailed Card -->
<div class="lg:col-span-6 bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col sm:flex-row gap-space-lg items-center sm:items-start relative overflow-hidden">
<div class="w-36 h-44 rounded-lg overflow-hidden shrink-0 bg-surface-container-high shadow-md">
<div class="w-full h-full bg-cover bg-center" data-alt="Distinguished professional executive portrait of Shri Parth Jaiswal IAS District Magistrate Collector dressed in crisp formal administrative attire with Indian tricolor in background" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAvX5W2Qu_fTOuCwZRp38ZuHZqJKdaOuhajPmSow4TW8-7AASUUOyXgQIO582Z6nm4C1UdKt74t6N5IHk1Yj4c5Wp7IuO1soy2MmS8TCM0lBuXeKldFbK_sq73tfXdixlqveLZjNgSAM56O3EjIry9gomf2w0AdAqJvLSfWzCz9Zh-i50yxv0Yxxvm-m5JxrjRj9Y3LXMJahJC1sc4-TM9jWqwYW2Ij6BQGyGmqdZE')"></div>
</div>
<div class="flex flex-col justify-between h-full w-full">
<div>
<div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm font-semibold mb-2">
<span class="material-symbols-outlined text-[14px]">shield</span>
                जिला दंडाधिकारी एवं कलेक्टर
              </div>
<h3 class="font-headline-md text-headline-md text-on-surface font-bold">श्री पार्थ जैसवाल, भा.प्र.से.</h3>
<p class="font-label-md text-label-md text-on-surface-variant mt-0.5">IAS (बैच 2015, मध्य प्रदेश कैडर) • UPSC Direct Recruitment</p>
<p class="font-body-sm text-body-sm text-on-surface-variant mt-3 line-clamp-3">
                "शहडोल जिले के प्रत्येक नागरिक तक शासन की जनकल्याणकारी योजनाओं का पारदर्शी, त्वरित और समयबद्ध लाभ पहुंचाना तथा जिले के औद्योगिक, वानिकी व पर्यटन क्षमता को गति प्रदान करना हमारा प्राथमिक ध्येय है।"
              </p>
</div>
<div class="mt-4 pt-3 flex flex-wrap gap-2 text-label-sm font-label-sm text-on-surface-variant">
<span class="inline-flex items-center gap-1 bg-surface-container-low px-2 py-1 rounded">
<span class="material-symbols-outlined text-[15px] text-primary">mail</span> dmshahdol@nic.in
              </span>
<span class="inline-flex items-center gap-1 bg-surface-container-low px-2 py-1 rounded">
