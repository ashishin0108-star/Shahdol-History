<div class="max-w-[1360px] mx-auto relative z-10">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-center">
<div class="lg:col-span-8 flex flex-col gap-space-md">
<div class="flex flex-wrap items-center gap-space-xs">
<span class="px-space-sm py-1 rounded bg-secondary text-on-secondary font-label-sm text-label-sm uppercase tracking-widest font-bold">
              ऐतिहासिक धरोहर अभिलेख • Heritage Archive
            </span>
<span class="text-on-primary-container font-label-sm text-label-sm">
              गोंडवाना, कलचुरी एवं बघेलखंड का गौरवमयी संगम
            </span>
</div>
<h1 class="font-headline-xl text-headline-xl text-on-primary tracking-tight leading-tight">
            शहडोल का गौरवशाली इतिहास एवं कालजयी विरासत
          </h1>
<p class="font-body-lg text-body-lg text-primary-fixed leading-relaxed max-w-3xl">
            विंध्याचल और मैकल पर्वतमालाओं के सुरम्य वन-प्रांतर में स्थित शहडोल, दसवीं सदी के कलचुरी स्थापत्य, रीवा रियासत के शौर्य तथा कोल-गोंड-बैगा जनजातीय सांस्कृतिक समृद्धि की पावन संगम-स्थली है। चरवाहे ‘शाहडोलवा अहीर’ की छांव से आधुनिक संभाग मुख्यालय तक की युगीन यात्रा का आधिकारिक प्रलेखन।
          </p>
<div class="flex flex-wrap items-center gap-space-md pt-space-xs">
<a class="px-space-lg py-3 rounded bg-secondary hover:bg-secondary/90 text-on-secondary font-title-md text-title-md transition-all shadow-sm flex items-center gap-2" href="#etymology">
<span class="material-symbols-outlined text-[20px]">menu_book</span>
              नामकरण व इतिहास पढ़ें
            </a>
<a class="px-space-lg py-3 rounded bg-surface-container-lowest/10 hover:bg-surface-container-lowest/20 text-on-primary font-title-md text-title-md backdrop-blur-sm transition-all flex items-center gap-2" href="#monuments">
<span class="material-symbols-outlined text-[20px]">account_balance</span>
